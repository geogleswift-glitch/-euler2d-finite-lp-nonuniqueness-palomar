module

public import RequestProject.Euler.ExteriorContourForcing

/-! The full-time physical cell produces a genuine forcing in the
original C¹ Hölder contour norm, with its exact proven Laplace moment
as the leading coefficient. No contour-norm error is assumed. -/

@[expose] public section

set_option maxHeartbeats 1000000

noncomputable section

open Complex ComplexConjugate Set MeasureTheory
open scoped NNReal

namespace Euler2D.CircularMaterialTransferProfile

variable {γ : ℝ≥0} {hγ : 0 < γ} {hγ1 : (γ : ℝ) < 1}
  (P : CircularMaterialTransferProfile hγ hγ1)

def physicalForcingMomentBudget (t A r : ℝ) : ℝ :=
  |A| * r ^ 10 * P.physicalSupportRadius t ^ 8 *
    finiteContourPatchMassBound circularContourStrengths circularContourRadii

theorem physicalForcingMomentBudget_bounds (t A : ℝ) {r : ℝ} (hr : 0 < r) :
    (∫ z : ℂ, ‖z‖ ^ 8 * |scaledComplexDensity A r (P.physicalVorticity t) z|) ≤
      P.physicalForcingMomentBudget t A r := by
  rw [absMoment_scaledComplexDensity A hr]
  calc
    _ ≤ |A| * r ^ 10 * (P.physicalSupportRadius t ^ 8 *
        finiteContourPatchMassBound circularContourStrengths circularContourRadii) :=
      mul_le_mul_of_nonneg_left (P.physicalVorticity_absMoment_le t 8) (by positivity)
    _ = _ := by unfold physicalForcingMomentBudget; ring

/-- A genuine C¹γ forcing generated by the entire actual cell, past
and future, whose leading coefficient is the same N(t) appearing in
the proved nonzero retarded response. -/
theorem exists_physical_scaled_contour_remainderC1 {η : ℝ≥0} (hη : (η : ℝ) ≤ 1)
    (t A : ℝ) {r d : ℝ} (hr : 0 < r) (hd : 0 < d)
    (hsep : 4 * r * P.physicalSupportRadius t ≤ d)
    (Z : ContourC1Space η) (hZ : ∀ x, d ≤ ‖ContourC1Space.toBCF η Z x‖) :
    ∃ Q : ContourC1Space η,
      (∀ θ, ContourC1Space.lift η Q θ =
        velocityC (scaledComplexDensity A r (P.physicalVorticity t)) (ContourC1Space.lift η Z θ) -
          I / (2 * Real.pi) * ((A : ℂ) * (r : ℂ) ^ 6 * P.moment t) *
            (conj (ContourC1Space.lift η Z θ) ^ 5)⁻¹) ∧
      ‖Q‖ ≤ max (exteriorFourthDerivativeBound (P.physicalForcingMomentBudget t A r) d 0)
        (2 * (exteriorFourthDerivativeBound (P.physicalForcingMomentBudget t A r) d 1 +
          Real.pi ^ (1 - (η : ℝ)) * exteriorFourthDerivativeBound (P.physicalForcingMomentBudget t A r) d 2 *
            ‖Z‖) * ‖Z‖) := by
  have hR := P.physicalSupportRadius_pos t
  have hi := integrable_scaledComplexDensity (P.integrable_physicalVorticity t) A hr.ne'
  have hs := scaledComplexDensity_support (P.physicalVorticity_support t) hr A
  have hmass : (∫ z, scaledComplexDensity A r (P.physicalVorticity t) z) = 0 := by
    rw [integral_scaledComplexDensity A hr.le, P.integral_physicalVorticity_zero t, mul_zero]
  obtain ⟨Q, hQ, hnorm⟩ := exists_exteriorContourRemainderC1 hη (S := r * P.physicalSupportRadius t)
    (by positivity) hi hs hmass (scaledComplexDensity_fourfold (P.physicalVorticity_fourfold t) A r)
    (P.physicalForcingMomentBudget_bounds t A hr) hd (by nlinarith) Z hZ
  refine ⟨Q, ?_, hnorm⟩
  intro θ
  rw [hQ θ, P.exteriorFourthRemainder_physical_scaled_eq t A hr]

end Euler2D.CircularMaterialTransferProfile

end
